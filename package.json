{
  "name": "or3-plugin-tasks",
  "version": "0.2.0",
  "private": true,
  "description": "Portable task lists for OR3: tasks, subtasks, labels, due dates and progress.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@or3/plugin-sdk": "2.0.0"
  },
  "scripts": {
    "profile:generate": "bun .authoring/generate.mjs",
    "profile:check": "bun .authoring/generate.mjs --check",
    "test": "bun test client.test.mjs",
    "validate": "bun --bun node_modules/.bin/or3-plugin validate .",
    "build": "bun run profile:check && bun --bun node_modules/.bin/or3-plugin build .",
    "pack": "bun --bun node_modules/.bin/or3-plugin pack dist --archive .artifacts/or3sal.tasks-0.2.0.or3pkg",
    "build:zip": "bun run build && bun run pack"
  },
  "overrides": {
    "@or3/plugin-sdk": "file:.authoring/vendor/or3-plugin-sdk-2.0.0.tgz"
  }
}
